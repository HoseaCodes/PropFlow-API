# PropFlow API -- example environment configuration.
#
# Copy to .env and fill in values for your machine:
#     cp .env.example .env
#
# .env is gitignored and must never be committed.
# This file contains PLACEHOLDERS ONLY -- never put a real credential here.

# --- Database ---------------------------------------------------------------
# These defaults match the PostgreSQL service in docker-compose.yml, so they
# work out of the box for local development. They are throwaway credentials for
# a local container and are not secrets.
DB_URL=jdbc:postgresql://localhost:5432/propflow
DB_USERNAME=propflow
DB_PASSWORD=propflow

# Host port for the Compose database. Change this if you already have something
# listening on 5432 (another local PostgreSQL is the usual culprit) and update
# the port in DB_URL to match.
DB_HOST_PORT=5432

# Host port for the Adminer database browser. Change if 8082 is taken.
ADMINER_HOST_PORT=8082

# Consumed by the "db" service in docker-compose.yml. Keep in sync with the
# DB_* values above.
POSTGRES_DB=propflow
POSTGRES_USER=propflow
POSTGRES_PASSWORD=propflow

# --- Security ---------------------------------------------------------------
# HMAC key used to sign JWTs. There is NO default: the application refuses to
# start without one, because a fallback signing key would let anyone with the
# source forge a token for any account.
#
# Generate your own before running:
#     openssl rand -base64 48
#
# The value below is a non-functional placeholder, not a usable key.
JWT_SECRET=replace-me-run-openssl-rand-base64-48-to-generate-a-real-key

# Token lifetime. A stateless JWT cannot be revoked before it expires, so this
# is the ceiling on how long a leaked token stays useful. Keep it short.
JWT_EXPIRATION=1h

# Comma-separated browser origins allowed to call the API. "*" is rejected.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Application ------------------------------------------------------------
# dev | prod
SPRING_PROFILES_ACTIVE=dev
PORT=8080
