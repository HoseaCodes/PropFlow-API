# PropFlow API -- example environment configuration.
#
# Copy to .env and fill in values for your machine:
#     cp .env.example .env
#
# .env is gitignored and must never be committed.
# This file contains PLACEHOLDERS ONLY -- never put a real credential here.

# --- Database ---------------------------------------------------------------
# These defaults match the PostgreSQL service in docker-compose.yml, so they
# work out of the box for local development. They are throwaway credentials for
# a local container and are not secrets.
DB_URL=jdbc:postgresql://localhost:5432/propflow
DB_USERNAME=propflow
DB_PASSWORD=propflow

# Host port for the Compose database. Change this if you already have something
# listening on 5432 (another local PostgreSQL is the usual culprit) and update
# the port in DB_URL to match.
DB_HOST_PORT=5432

# Consumed by the "db" service in docker-compose.yml. Keep in sync with the
# DB_* values above.
POSTGRES_DB=propflow
POSTGRES_USER=propflow
POSTGRES_PASSWORD=propflow

# --- Application ------------------------------------------------------------
# dev | prod
SPRING_PROFILES_ACTIVE=dev
PORT=8080
