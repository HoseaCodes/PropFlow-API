# Keep the build context small and, more importantly, keep local secrets out
# of it. The Dockerfile's build stage does `COPY . .`, so without this file
# .env would be copied into a build layer.
.env
.env.*
!.env.example

.git
.github
target/
docs/
logs/
*.log

# IDE / editor
.idea/
.vscode/
.settings/
.classpath
.project
.factorypath
*.iml

.DS_Store
